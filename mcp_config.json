{
  "mcpServers": {
    "pd-audit": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${PLUGIN_ROOT}/servers/pd-audit",
        "python",
        "-m",
        "pd_audit.mcp_server"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv"
      },
      "timeoutSeconds": 300
    }
  }
}
